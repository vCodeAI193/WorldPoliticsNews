{
  "name": "worldpoliticsnews",
  "private": true,
  "workspaces": [
    "backend",
    "apps/web",
    "apps/mobile",
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test --workspace=backend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:web": "npm run dev --workspace=apps/web",
    "build:types": "npm run build --workspace=packages/shared-types",
    "build:backend": "npm run build:types && npm run build --workspace=backend",
    "build:web": "npm run build:types && npm run build --workspace=apps/web",
    "db:generate": "npm run db:generate --workspace=backend",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:studio": "npm run db:studio --workspace=backend"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "overrides": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
