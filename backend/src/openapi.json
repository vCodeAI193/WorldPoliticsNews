{
  "openapi": "3.0.0",
  "info": {
    "title": "WorldPoliticsNews API",
    "version": "1.0.0",
    "description": "KI-gestützte Analyse von Politikernachrichten weltweit",
    "contact": {
      "name": "Support",
      "email": "support@worldpoliticsnews.com"
    },
    "license": {
      "name": "MIT"
    }
  },
  "servers": [
    {
      "url": "https://api.worldpoliticsnews.com",
      "description": "Production"
    },
    {
      "url": "http://localhost:3001",
      "description": "Development"
    }
  ],
  "paths": {
    "/api/politicians/search": {
      "get": {
        "summary": "Politiker suchen",
        "description": "Sucht Politiker nach Name und optionalem Land",
        "tags": ["Politicians"],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Suchbegriff",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Länderfilter",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Suchergebnisse erfolgreich abgerufen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResult"
                }
              }
            }
          },
          "400": {
            "description": "Ungültige Anfrageparameter"
          }
        }
      }
    },
    "/api/politicians/{id}/analysis": {
      "get": {
        "summary": "Analyse eines Politikers",
        "description": "Ruft die KI-gestützte Sentiment-Analyse für einen Politiker ab",
        "tags": ["Politicians"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Politiker-ID",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "query",
            "required": true,
            "description": "Name des Politikers",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "force",
            "in": "query",
            "required": false,
            "description": "Neue Analyse erzwingen (ignoriert Cache)",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Analyse erfolgreich abgerufen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisResult"
                }
              }
            }
          },
          "404": {
            "description": "Politiker nicht gefunden"
          },
          "429": {
            "description": "Zu viele Anfragen"
          }
        }
      }
    },
    "/api/parties/search": {
      "get": {
        "summary": "Parteien suchen",
        "description": "Sucht Parteien nach Name und optionalem Land",
        "tags": ["Parties"],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Suchbegriff",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Länderfilter",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Suchergebnisse erfolgreich abgerufen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/parties/{id}/analysis": {
      "get": {
        "summary": "Analyse einer Partei",
        "description": "Ruft die KI-gestützte Sentiment-Analyse für eine Partei ab",
        "tags": ["Parties"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Partei-ID",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "query",
            "required": true,
            "description": "Name der Partei",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "force",
            "in": "query",
            "required": false,
            "description": "Neue Analyse erzwingen",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Analyse erfolgreich abgerufen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisResult"
                }
              }
            }
          },
          "404": {
            "description": "Partei nicht gefunden"
          }
        }
      }
    },
    "/api/watchlist": {
      "get": {
        "summary": "Beobachtungsliste abrufen",
        "description": "Ruft die Beobachtungsliste des authentifizierten Benutzers ab",
        "tags": ["Watchlist"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Beobachtungsliste erfolgreich abgerufen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WatchlistResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentifizierung erforderlich"
          }
        }
      },
      "post": {
        "summary": "Item zur Beobachtungsliste hinzufügen",
        "description": "Fügt einen Politiker oder eine Partei zur Beobachtungsliste hinzu",
        "tags": ["Watchlist"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WatchlistItem"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Item erfolgreich hinzugefügt"
          },
          "400": {
            "description": "Ungültige Anfrage"
          },
          "401": {
            "description": "Authentifizierung erforderlich"
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "summary": "Benutzer registrieren",
        "description": "Erstellt ein neues Benutzerkonto",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Benutzer erfolgreich registriert",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "400": {
            "description": "Ungültige oder bereits existierende Email"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Benutzer anmelden",
        "description": "Authentifiziert einen Benutzer und gibt JWT-Token zurück",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Anmeldung erfolgreich",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "401": {
            "description": "Ungültige Anmeldedaten"
          }
        }
      }
    },
    "/api/trending": {
      "get": {
        "summary": "Trending Entities abrufen",
        "description": "Ruft die meistgesuchten oder am höchsten bewerteten Politiker und Parteien ab",
        "tags": ["Trending"],
        "parameters": [
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Länderfilter",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Anzahl der Ergebnisse",
            "schema": {
              "type": "integer",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Trending Entities erfolgreich abgerufen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrendingResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Health Check",
        "description": "Überprüft die Verfügbarkeit des API-Servers und der Datenbankverbindung",
        "tags": ["System"],
        "responses": {
          "200": {
            "description": "Server ist verfügbar",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Server ist nicht verfügbar"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SearchResult": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Entity"
            }
          },
          "total": {
            "type": "integer"
          }
        }
      },
      "Entity": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["politiker", "partei"]
          },
          "country": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "AnalysisResult": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "entityId": {
                "type": "string"
              },
              "entityName": {
                "type": "string"
              },
              "sentiment": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              "sentimentLabel": {
                "type": "string",
                "enum": ["positive", "negative", "neutral"]
              },
              "summary": {
                "type": "string"
              },
              "articles": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Article"
                }
              },
              "keywords": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "generatedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      },
      "Article": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "source": {
            "type": "string"
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time"
          },
          "sentiment": {
            "type": "string",
            "enum": ["positive", "negative", "neutral"]
          }
        }
      },
      "WatchlistResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WatchlistItem"
            }
          }
        }
      },
      "WatchlistItem": {
        "type": "object",
        "properties": {
          "entityType": {
            "type": "string",
            "enum": ["politiker", "partei"]
          },
          "entityId": {
            "type": "string"
          },
          "entityName": {
            "type": "string"
          },
          "entityCountry": {
            "type": "string"
          }
        },
        "required": ["entityType", "entityId", "entityName"]
      },
      "RegisterRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8
          }
        },
        "required": ["email", "password"]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        },
        "required": ["email", "password"]
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "type": "object",
            "properties": {
              "user": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  },
                  "subscriptionTier": {
                    "type": "string",
                    "enum": ["free", "plus"]
                  }
                }
              },
              "token": {
                "type": "string"
              },
              "refreshToken": {
                "type": "string"
              }
            }
          }
        }
      },
      "TrendingResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "type": "object",
            "properties": {
              "politicians": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/TrendingEntity"
                }
              },
              "parties": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/TrendingEntity"
                }
              }
            }
          }
        }
      },
      "TrendingEntity": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "sentiment": {
            "type": "number"
          },
          "sentimentLabel": {
            "type": "string"
          },
          "searchCount": {
            "type": "integer"
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "db": {
            "type": "string",
            "enum": ["ok", "error"]
          },
          "demo": {
            "type": "boolean"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT token for authentication"
      }
    }
  },
  "tags": [
    {
      "name": "Politicians",
      "description": "Operationen mit Politikern"
    },
    {
      "name": "Parties",
      "description": "Operationen mit Parteien"
    },
    {
      "name": "Watchlist",
      "description": "Beobachtungslisten-Verwaltung"
    },
    {
      "name": "Authentication",
      "description": "Authentifizierung und Benutzerkonten"
    },
    {
      "name": "Trending",
      "description": "Trending Entitäten"
    },
    {
      "name": "System",
      "description": "System-APIs"
    }
  ]
}
